NEXT_PUBLIC_SITE_URL=https://fydor.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_PACK_BUCKET=packs
# DATABASE_URL is required only by Drizzle commands and the controlled
# admin-bootstrap script; it is not needed by the running website.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
