{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/downloads/fydor-mac.dmg",
      "destination": "https://github.com/bun781/Triolinga/releases/latest/download/fydor-mac.dmg",
      "permanent": false
    },
    {
      "source": "/downloads/fydor-windows.exe",
      "destination": "https://github.com/bun781/Triolinga/releases/latest/download/fydor-windows.exe",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
